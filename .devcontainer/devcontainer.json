{
  // コンテナ表示名
  "name": "react-go-lab",
  // Node.js 24 + TypeScript ベースイメージ
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  // 追加ツール: git / GitHub CLI / Go をイメージに同梱
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/go:1": {}
  },
  // ① 生成直後に一度だけ: corepack で pnpm を有効化
  "onCreateCommand": "corepack enable && corepack prepare pnpm@latest --activate",
  // ② ソース取得後: package.json があれば依存をインストール（無ければ何もしない）
  "updateContentCommand": "test -f package.json && (pnpm install --frozen-lockfile || pnpm install) || true",
  // ③ 作成完了後: 追加セットアップ (claude CLI, lefthook の git hooks 登録)
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // dev サーバ・backend は手動で起動する（接続ごとの多重起動を避けるため自動起動しない）
  // ホストへ公開するポート: 5173 = Vite dev server / 8080 = Go backend
  "forwardPorts": [5173, 8080],
  // 公開ポートの表示名と自動フォワード時の挙動
  // openPreview は転送イベントごとにプレビューを開き、コンテナ環境では
  // 連鎖して無限にブラウザが生成されることがあるため silent にする。
  // 必要なときは Ports パネル、またはターミナルに表示される URL から手動で開く。
  "portsAttributes": {
    "5173": {
      "label": "Vite dev server (frontend)",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "Go backend (API)",
      "onAutoForward": "silent"
    }
  },
  // VS Code 固有の設定（拡張機能・エディタ設定）
  "customizations": {
    "vscode": {
      // コンテナに自動インストールする拡張機能
      "extensions": [
        "biomejs.biome",
        "golang.go",
        "bradlc.vscode-tailwindcss",
        "yoavbls.pretty-ts-errors",
        "streetsidesoftware.code-spell-checker",
        "github.vscode-github-actions"
      ],
      // 保存時フォーマット等のワークスペース設定（Biome を既定フォーマッタに）
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        },
        "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
        "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
        "[json]": { "editor.defaultFormatter": "biomejs.biome" },
        "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
        "tailwindCSS.experimental.classRegex": [
          ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
          ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
        ]
      }
    }
  },
  // コンテナ内で使用するユーザー（個人専用環境のため root で統一）
  "remoteUser": "root",
  // コンテナ内プロセスに渡す環境変数
  "remoteEnv": {
    // Docker / Codespaces 上で Vite (chokidar) のファイル監視をポーリングにし、
    // HMR / Fast Refresh を確実にする。
    "CHOKIDAR_USEPOLLING": "true"
  }
}
