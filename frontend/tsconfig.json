{
  "compilerOptions": {
    // 出力するJSの言語水準とブラウザAPIの型
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "skipLibCheck": true,

    // Vite が変換するので tsc 自身はJSを出力しない（型チェック専用）
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",

    // 厳格設定（学習向けに緩めない）
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // "@/*" を src/* に解決（vite.config の alias と対になる）
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  //  型チェック対象。src と、Node 文脈の vite.config.ts も含める
  "include": ["src", "vite.config.ts"]
}
